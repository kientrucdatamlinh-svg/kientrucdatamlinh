{
  "cleanUrls": false,
  "redirects": [
    {
      "source": "/tu-van-phong-thuy.html",
      "destination": "/phong-thuy.html",
      "permanent": true
    },
    {
      "source": "/xem-huong-mo-kich-thuoc-mo.html",
      "destination": "/phong-thuy.html",
      "permanent": true
    },
    {
      "source": "/tu-van-lap-dat.html",
      "destination": "/lap-dat.html",
      "permanent": true
    },
    {
      "source": "/kientrucdatamlinh.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/scratch/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(site-common|mobile)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/tin-tuc/:path",
      "destination": "/api/bai-viet?path=:path"
    },
    {
      "source": "/san-pham/:path",
      "destination": "/api/san-pham?path=:path"
    },
    {
      "source": "/du-an/:path",
      "destination": "/api/du-an?path=:path"
    },
    {
      "source": "/:c(mau-mo-da-dep|lang-tho-da|nha-tho-ho-bang-da|cong-da|tuong-da-linh-vat|lan-can-da|cuon-thu-da|thap-da)",
      "destination": "/api/danh-muc?c=:c"
    }
  ],
  "functions": {
    "api/bai-viet.js": {
      "includeFiles": "{live_overrides.json,product_descriptions.json}"
    },
    "api/sitemap.js": {
      "includeFiles": "{live_overrides.json,product_descriptions.json}"
    },
    "api/san-pham.js": {
      "includeFiles": "{live_overrides.json,product_descriptions.json}"
    },
    "api/du-an.js": {
      "includeFiles": "{live_overrides.json,product_descriptions.json}"
    },
    "api/danh-muc.js": {
      "includeFiles": "{live_overrides.json,product_descriptions.json}"
    }
  }
}
